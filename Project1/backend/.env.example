# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/Banquet?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string

# Server port
PORT=5000

# SMTP (for sending emails via nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
